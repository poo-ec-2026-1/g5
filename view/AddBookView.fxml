<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="bg-default" stylesheets="@application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddBookController">
   <top>
      <Label styleClass="title-1" text="Cadastrar Novo Livro" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <VBox alignment="TOP_CENTER" fillWidth="false" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefWidth="500.0" spacing="15.0" styleClass="surface">
               <children>
                  <Label text="Informações do Livro">
                     <styleClass>
                        <String fx:value="title-2" />
                     </styleClass>
                  </Label>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Título do Livro *" />
                        <TextField fx:id="txtTitulo" promptText="Ex: O Senhor dos Anéis" styleClass="input-field" />
                        <Label fx:id="lblErroTitulo" styleClass="error-text" text="Título é obrigatório" visible="false" managed="false" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Autor *" />
                        <TextField fx:id="txtAutor" promptText="Ex: J.R.R. Tolkien" styleClass="input-field" />
                        <Label fx:id="lblErroAutor" styleClass="error-text" text="Autor é obrigatório" visible="false" managed="false" />
                     </children>
                  </VBox>

                  <HBox spacing="20.0">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="ISBN" />
                              <TextField fx:id="txtIsbn" promptText="Ex: 978-3-16-148410-0" styleClass="input-field" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Estado de Conservação" />
                              <ComboBox fx:id="cmbEstado" prefWidth="230.0" promptText="Selecione o estado" styleClass="input-field" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
            
            <VBox prefWidth="500.0" spacing="15.0" styleClass="surface">
               <children>
                  <Label text="Detalhes do Anúncio">
                     <styleClass>
                        <String fx:value="title-2" />
                     </styleClass>
                  </Label>
                  
                  <HBox spacing="20.0">
                     <children>
                        <RadioButton fx:id="rbVenda" mnemonicParsing="false" selected="true" text="Venda">
                           <toggleGroup>
                              <ToggleGroup fx:id="tipoAnuncio" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbTroca" mnemonicParsing="false" text="Troca" toggleGroup="$tipoAnuncio" />
                     </children>
                  </HBox>
                  
                  <VBox fx:id="boxPreco" spacing="5.0">
                     <children>
                        <Label text="Preço (R$) *" />
                        <TextField fx:id="txtPreco" promptText="0.00" styleClass="input-field" />
                        <Label fx:id="lblErroPreco" styleClass="error-text" text="Preço inválido" visible="false" managed="false" />
                     </children>
                  </VBox>
                  
                  <VBox fx:id="boxProcura" managed="false" spacing="5.0" visible="false">
                     <children>
                        <Label text="O que você procura em troca? *" />
                        <TextField fx:id="txtProcura" promptText="Ex: Livro de ficção científica" styleClass="input-field" />
                        <Label fx:id="lblErroProcura" styleClass="error-text" text="Este campo é obrigatório para trocas" visible="false" managed="false" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Descrição Adicional" />
                        <TextArea fx:id="txtDescricao" prefHeight="80.0" prefWidth="200.0" promptText="Escreva detalhes adicionais sobre o livro ou a negociação..." styleClass="input-field" />
                     </children>
                  </VBox>
                  
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
            
            <Button mnemonicParsing="false" onAction="#salvarAnuncio" prefHeight="40.0" prefWidth="500.0" styleClass="btn-primary" text="Publicar Anúncio">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
