<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>

<AnchorPane styleClass="bg-default" stylesheets="@application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CatalogController">
   <children>
      <!-- Conteúdo principal -->
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <Label styleClass="title-1" text="Catálogo de Livros" BorderPane.alignment="CENTER_LEFT">
               <BorderPane.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </BorderPane.margin>
            </Label>
         </top>
         <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
               <content>
                  <FlowPane fx:id="cardsContainer" alignment="CENTER" hgap="20.0" style="-fx-background-color: #F8F9FA;" vgap="20.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                  </FlowPane>
               </content>
            </ScrollPane>
         </center>
         <right>
            <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <bottom>
            
                  <!-- Imagem decorativa no canto superior direito (declarada por último para ficar na frente) -->
                  <ImageView fitHeight="300.0" fitWidth="300.0" mouseTransparent="true" pickOnBounds="false" preserveRatio="true" BorderPane.alignment="CENTER">
                     <image>
                        <Image url="@../resources/images/ImagemCatalogo.png" />
                     </image>
                     <BorderPane.margin>
                        <Insets bottom="30.0" />
                     </BorderPane.margin>
                  </ImageView>
               </bottom>
            </BorderPane>
         </right>
      </BorderPane>
   </children>
</AnchorPane>
