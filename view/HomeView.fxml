<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="532.0" prefWidth="760.0" styleClass="bg-default" stylesheets="@application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ImageView fitHeight="349.0" fitWidth="347.0" layoutX="403.0" layoutY="160.0" opacity="0.6" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="23.0" AnchorPane.rightAnchor="10.0">
         <image>
            <Image url="@../resources/images/ImagemLivros.png" />
         </image>
      </ImageView>
      <VBox layoutX="50.0" layoutY="50.0" prefHeight="432.0" prefWidth="541.0" spacing="25.0" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="50.0">
         <children>
            <VBox spacing="10.0">
               <children>
                  <Label style="-fx-font-size: 32px; -fx-font-weight: bold;" text="Olá, leitor! Bem-vindo ao TradeLibrary" wrapText="true">
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                  </Label>
                  <Label prefHeight="48.0" prefWidth="541.0" style="-fx-font-size: 18px; -fx-text-fill: #555;" text="O lugar onde livros ganham novas histórias e novos leitores." wrapText="true" />
               </children>
            </VBox>
            <VBox spacing="12.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-font-size: 18px;" text="Troque os livros que já leu por novas aventuras" />
