            <Button fx:id="btnCadastrarHome" mnemonicParsing="false" prefHeight="50.0" prefWidth="230.0" style="-fx-background-radius: 25; -fx-font-size: 18px;" styleClass="btn-primary" text="Cadastrar Livro">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
